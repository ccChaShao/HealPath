page{background:#f5f6f2;color:#304936;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.container{padding:28rpx 28rpx 190rpx}.card{background:#fffefb;border:1rpx solid #e3e9dc;border-radius:28rpx;padding:32rpx;margin-bottom:24rpx}.title{font-size:34rpx;font-weight:600}.section-title{font-size:29rpx;font-weight:600;margin-bottom:24rpx}.muted{font-size:23rpx;color:#899880;line-height:1.8}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.green{color:#39704f}.primary{background:#33664d!important;color:#fff!important;border-radius:18rpx;font-size:27rpx;line-height:84rpx;margin:18rpx 0}.secondary{background:#ecf1e5!important;color:#4d7444!important;border-radius:16rpx;font-size:25rpx;line-height:76rpx;margin:16rpx 0}.danger{background:#fff0eb!important;color:#aa6557!important;border-radius:16rpx;font-size:25rpx;line-height:76rpx}button:after{border:0}.tag{display:inline-block;font-size:20rpx;padding:7rpx 12rpx;border-radius:9rpx;background:#edf2e5;color:#6a8857}.amber{background:#fbf0dc;color:#a5834d}.empty{text-align:center;padding:58rpx 15rpx;color:#8a9e7a;line-height:2;font-size:26rpx}.list-row{padding:27rpx 0;border-bottom:1rpx solid #eaf0e2}.list-row:last-child{border:0}.list-title{font-size:28rpx;margin-bottom:10rpx}.hint{background:#edf1e6;color:#7c906e;font-size:22rpx;line-height:1.9;padding:22rpx;border-radius:16rpx;margin:20rpx 0}.field{margin-bottom:27rpx}.label{font-size:23rpx;color:#7c916d;margin-bottom:13rpx}input,.picker,textarea{box-sizing:border-box;width:100%;border:1rpx solid #dfe7d7;border-radius:14rpx;background:white;padding:22rpx;font-size:27rpx;min-height:80rpx}textarea{height:180rpx;line-height:1.6}.small-link{font-size:24rpx;color:#4b7741;padding:10rpx}.tabs{display:flex;background:#eaf0e3;border-radius:17rpx;padding:7rpx;margin-bottom:24rpx}.tabs view{flex:1;text-align:center;padding:16rpx 5rpx;font-size:24rpx;color:#819572}.tabs .active{background:#fffefb;border-radius:12rpx;color:#456b3b}.page-note{text-align:center;font-size:20rpx;color:#95a488;line-height:1.9;margin:25rpx 0}.check{width:42rpx;height:42rpx;line-height:42rpx;border:2rpx solid #ccdbc0;border-radius:50%;text-align:center;color:#fff;flex-shrink:0}.check.done{background:#819e6e}.check.skipped{background:#ada890}.grow{flex:1;min-width:0}.divider{height:1rpx;background:#e7eddf;margin:24rpx 0}.body-text{font-size:27rpx;line-height:1.9;white-space:pre-wrap;word-break:break-all}.metric-row{display:flex;gap:14rpx;justify-content:space-between;padding:21rpx 0;border-bottom:1rpx solid #e6ecdf}.metric-row>view{flex:1}.right{text-align:right}
