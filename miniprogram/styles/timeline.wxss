.timeline-month-label{font-size:24rpx;color:#859776;margin:25rpx 0 26rpx;letter-spacing:2rpx}.timeline-day{display:flex;gap:22rpx}.timeline-date{width:102rpx;flex-shrink:0;text-align:right;padding-top:24rpx;color:#8c9b80;font-size:21rpx;line-height:1.9}.timeline-number{font-size:53rpx;color:#557545;font-family:Georgia,serif;line-height:1.1;margin-bottom:10rpx}.timeline-full-date{font-size:17rpx;white-space:nowrap}.timeline-track{flex:1;min-width:0;border-left:2rpx solid #d9e3ce;padding:0 0 27rpx 24rpx;position:relative}.timeline-dot{position:absolute;top:35rpx;left:-9rpx;width:12rpx;height:12rpx;background:#fffefb;border:3rpx solid #7e9c6b;border-radius:50%;box-shadow:0 0 0 6rpx #fffefb}.timeline-entry{background:#f7faf2;border:1rpx solid #e1e8d7;border-radius:19rpx;padding:22rpx;margin-bottom:16rpx}.timeline-entry:last-child{margin-bottom:0}.timeline-entry-title{font-size:28rpx;font-weight:500;line-height:1.7;margin-top:17rpx;word-break:break-all}.timeline-entry-note{font-size:23rpx;color:#8b9b7d;line-height:1.8;margin-top:12rpx;white-space:pre-wrap;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;word-break:break-all}.timeline-topic{background:#edeadf;color:#978667;margin-left:8rpx}.timeline-edit{font-size:20rpx;color:#839b71;flex-shrink:0}.timeline-filter{display:flex;gap:15rpx;margin:22rpx 0}.timeline-filter .picker{font-size:24rpx;min-height:65rpx;padding:16rpx 20rpx}.timeline-search{font-size:25rpx}.timeline-presets{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:17rpx}.timeline-presets>view{padding:12rpx 19rpx;background:#eaf0e2;color:#688958;border:1rpx solid #d9e3ce;border-radius:12rpx;font-size:23rpx}
