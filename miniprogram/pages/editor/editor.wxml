<view class="container"><view wx:if="{{kind !== 'patients'}}" class="hint">当前成员：{{memberName}}</view><view class="card">
  <block wx:for="{{fields}}" wx:key="name">
    <view class="field" wx:if="{{!item.optionalVisit || showVisitDetails}}">
      <view class="row"><view class="label">{{item.label}}</view><view wx:if="{{item.type === 'date' || item.type === 'time'}}" class="small-link" data-index="{{index}}" bindtap="clearField">清空</view></view>
      <textarea wx:if="{{item.type === 'textarea'}}" value="{{item.value}}" maxlength="4000" data-index="{{index}}" bindinput="updateField"/>
      <picker wx:elif="{{item.type === 'select'}}" range="{{item.options}}" range-key="label" value="{{item.selected}}" data-index="{{index}}" bindchange="updateField"><view class="picker">{{item.options[item.selected].label}} ⌄</view></picker>
      <picker wx:elif="{{item.type === 'date' || item.type === 'time'}}" mode="{{item.type}}" value="{{item.value}}" data-index="{{index}}" bindchange="updateField"><view class="picker">{{item.value || '请选择日期或时间'}} ⌄</view></picker>
      <input wx:else value="{{item.value}}" maxlength="200" data-index="{{index}}" bindinput="updateField"/>
      <block wx:if="{{kind === 'encounters' &amp;&amp; item.name === 'date'}}"><view class="timeline-presets"><view wx:for="{{dateOptions}}" wx:for-item="preset" wx:key="date" bindtap="pickTimelineDate" data-date="{{preset.date}}">{{preset.label}}</view></view><view class="muted">按自然月回溯，保存上方具体日期；目标月份无对应日时取月末。</view></block>
    </view>
  </block>
  <view wx:if="{{kind === 'encounters'}}" class="small-link" bindtap="toggleVisitDetails">{{showVisitDetails ? '收起' : '补充'}}医院、科室与就诊详情（选填）</view>
  <checkbox-group wx:if="{{kind === 'patients'}}" bindchange="toggleConsent"><label class="muted"><checkbox value="consent" checked="{{consent}}" color="#3b6f4e"/>这是我的档案，或我已经获得合法授权 / 具有监护权。</label></checkbox-group>
</view>
<block wx:if="{{kind === 'reports'}}"><view class="card"><view class="section-title">检验指标</view><view class="hint">按原件填写。检测方法与标本不明时请留空，不要猜测。保存后可以添加原件。</view><view class="observation" wx:for="{{observations}}" wx:key="key"><view class="row"><view class="label">第 {{index + 1}} 项</view><view class="small-link" data-index="{{index}}" bindtap="removeObservation">移除</view></view><picker range="{{metrics}}" range-key="name" value="{{item.metricIndex}}" data-index="{{index}}" data-key="metric" bindchange="updateObservation"><view class="picker">{{metrics[item.metricIndex].name}} ⌄</view></picker><view class="label space">结果（可填写“＜0.01”或文字）</view><input value="{{item.value}}" data-index="{{index}}" data-key="value" bindinput="updateObservation"/><view class="label space">单位</view><picker range="{{item.units}}" value="{{item.unitIndex}}" data-index="{{index}}" data-key="unit" bindchange="updateObservation"><view class="picker">{{item.unit}} ⌄</view></picker><view class="label space">原报告参考范围</view><input value="{{item.reference}}" data-index="{{index}}" data-key="reference" bindinput="updateObservation"/><view class="label space">原报告异常标记</view><picker range="{{item.flags}}" value="{{item.flagIndex}}" data-index="{{index}}" data-key="flag" bindchange="updateObservation"><view class="picker">{{item.flags[item.flagIndex]}} ⌄</view></picker></view><button class="secondary" bindtap="addObservation">＋ 添加指标</button><checkbox-group bindchange="toggleConfirmed"><label class="muted"><checkbox value="confirmed" checked="{{confirmed}}" color="#3b6f4e"/>我已核对日期、数值、单位和参考范围，允许进入正式对比。</label></checkbox-group></view><view class="hint">当前未接入 OCR，检验指标采用手动录入。原件支持 JPG、PNG、PDF。</view></block>
<view wx:if="{{kind === 'tasks'}}" class="hint">本地版不会发送手机提醒。已有执行记录的计划不能修改时间规则，可新建后续计划。</view><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button><button wx:if="{{id &amp;&amp; kind !== 'patients'}}" class="danger" bindtap="remove">删除记录</button></view>
