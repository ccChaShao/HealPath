@import "../../styles/timeline.wxss";
.header{margin:4rpx 0 25rpx}.brand{font-size:43rpx;font-weight:600;letter-spacing:3rpx}.header .muted{font-size:18rpx;letter-spacing:3rpx}.member{background:#fffefb;border:1rpx solid #e0e7d7;padding:16rpx 25rpx;border-radius:40rpx;font-size:25rpx}.stats{display:flex;justify-content:space-around;text-align:center;padding:16rpx 0}.number{font-size:50rpx;color:#62814e}.week{display:flex;gap:6rpx;margin:25rpx 0}.day{flex:1;text-align:center;padding:18rpx 0;color:#829772;font-size:24rpx}.day.selected{background:#e7efdf;border-radius:20rpx;color:#426d39}.day-number{font-size:32rpx;margin-top:18rpx}.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#fffefbf5;border-top:1rpx solid #e0e7d6;display:flex;justify-content:space-around;align-items:center;padding:14rpx 10rpx calc(14rpx + env(safe-area-inset-bottom));z-index:5}.bottom-nav>view{text-align:center;font-size:39rpx;line-height:1.1;color:#92a18a;min-width:78rpx}.bottom-nav text{display:block;font-size:21rpx;margin-top:9rpx}.bottom-nav .active{color:#46713c}.bottom-nav .add{border-radius:50%;background:#37694e;color:#fff;width:86rpx;height:86rpx;line-height:80rpx;font-size:56rpx;min-width:0}
