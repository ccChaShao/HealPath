<import src="../../templates/timeline.wxml"/>
<view class="container">
  <view class="row header"><view><view class="brand">愈之路</view><view class="muted">HEALTH JOURNEY</view></view><picker wx:if="{{patients.length}}" range="{{patients}}" range-key="name" value="{{patientIndex}}" bindchange="changePatient"><view class="member">{{patient.name}} ⌄</view></picker><view wx:else class="tag">本地开发版</view></view>
  <view class="hint">本地开发版 · 资料保存在电脑 · 未接入微信登录与云端</view>
  <view wx:if="{{!patient}}" class="card"><view class="title">从一份属于你的档案开始。</view><view class="empty">为自己或家人建立档案，<br/>把报告、就诊和下次复查放在一起。</view><button class="primary" bindtap="edit" data-kind="patients">建立第一份档案</button></view>
  <block wx:elif="{{page === 'home'}}">
    <view class="card"><view class="row"><view class="section-title">我的健康时间线</view><view class="small-link" bindtap="openTimeline">查看全部 →</view></view><view wx:if="{{!recentTimeline.length}}" class="empty">今天、前天，或三个月前的经历，<br/>都可以随时补记。</view><template is="healthTimeline" data="{{groups: recentTimeline}}"/><button class="secondary" bindtap="edit" data-kind="encounters">＋ 补记一次经历</button></view>
    <view class="card"><view class="row"><view class="section-title">档案小记</view><view class="small-link" bindtap="changePage" data-page="archive">查看档案 →</view></view><view class="stats"><view><view class="number">{{summary.reports.length}}</view><view class="muted">报告</view></view><view><view class="number">{{summary.encounters.length}}</view><view class="muted">时间线记录</view></view><view><view class="number">{{tasks.length}}</view><view class="muted">今日事项</view></view></view></view>
    <view class="card"><view class="row"><view class="section-title">今日事项</view><view class="small-link" bindtap="changePage" data-page="calendar">日历 →</view></view><view wx:if="{{!tasks.length}}" class="empty">今天还没有安排事项</view><view class="list-row row" wx:for="{{tasks}}" wx:key="id"><view class="check {{item.status}}" bindtap="toggle" data-id="{{item.id}}">{{item.status === 'done' ? '✓' : item.status === 'skipped' ? '−' : ''}}</view><view class="grow"><view class="list-title">{{item.title}}</view><view class="muted">{{item.type}} · {{item.time || '全天'}}</view></view></view><button class="secondary" bindtap="edit" data-kind="tasks">＋ 添加事项</button></view>
    <view class="card"><view class="section-title">最近的报告</view><view wx:if="{{!summary.reports.length}}" class="empty">上传第一份报告，开始记录</view><view wx:for="{{summary.reports}}" wx:key="id" wx:if="{{index < 3}}" class="list-row" bindtap="viewReport" data-id="{{item.id}}"><view class="row"><view class="list-title">{{item.title}}</view><view class="tag {{item.status === 'pending' ? 'amber' : ''}}">{{item.status === 'pending' ? '待核对' : '已核对'}}</view></view><view class="muted">{{item.date}} · {{item.hospital || '医院未填写'}}</view></view></view>
  </block>
  <block wx:elif="{{page === 'calendar'}}">
    <view class="card"><view class="row"><view class="small-link" bindtap="shiftDate" data-amount="-1">‹ 上周</view><picker mode="date" value="{{date}}" bindchange="changeDate"><view class="title">{{date}} ⌄</view></picker><view class="small-link" bindtap="shiftDate" data-amount="1">下周 ›</view></view><view class="week"><view wx:for="{{week}}" wx:key="date" class="day {{item.date === date ? 'selected' : ''}}" bindtap="changeDate" data-date="{{item.date}}"><view>{{item.label}}</view><view class="day-number">{{item.day}}</view></view></view><view class="section-title">当日事项</view><view wx:if="{{!tasks.length}}" class="empty">这一天还没有事项</view><view class="list-row" wx:for="{{tasks}}" wx:key="id"><view class="row"><view class="check {{item.status}}" bindtap="toggle" data-id="{{item.id}}">{{item.status === 'done' ? '✓' : item.status === 'skipped' ? '−' : ''}}</view><view class="grow" bindtap="edit" data-kind="tasks" data-id="{{item.id}}"><view class="list-title">{{item.title}}</view><view class="muted">{{item.type}} · {{item.time || '全天'}} · 点击编辑</view></view><view class="small-link" bindtap="toggle" data-id="{{item.id}}" data-skip="true">{{item.status === 'skipped' ? '恢复' : '跳过'}}</view></view></view><button class="primary" bindtap="edit" data-kind="tasks">＋ 添加日历事项</button></view><view class="hint">本地版记录日历，不会发送手机提醒。每日、每周计划会分别保留每次执行状态。</view>
  </block>
  <block wx:elif="{{page === 'archive'}}">
    <view class="tabs"><view class="{{archive === 'records' ? 'active' : ''}}" data-tab="records" bindtap="changeArchive">健康时间线</view><view class="{{archive === 'reports' ? 'active' : ''}}" data-tab="reports" bindtap="changeArchive">报告存档</view><view class="{{archive === 'trends' ? 'active' : ''}}" data-tab="trends" bindtap="changeArchive">指标历史</view></view>
    <view wx:if="{{archive === 'records'}}" class="card">
      <view class="row"><view class="section-title">我的健康时间线</view><view class="small-link" bindtap="edit" data-kind="encounters">＋ 添加</view></view>
      <input class="timeline-search" placeholder="搜索标题、标签、内容或日期" value="{{timelineSearch}}" bindinput="timelineQuery"/>
      <view class="timeline-filter"><picker range="{{timelineTypes}}" value="{{timelineTypeIndex}}" bindchange="timelineFilter" data-field="timelineTypeIndex"><view class="picker">{{timelineTypes[timelineTypeIndex]}} ⌄</view></picker><picker range="{{timelineSorts}}" value="{{timelineSortIndex}}" bindchange="timelineFilter" data-field="timelineSortIndex"><view class="picker">{{timelineSorts[timelineSortIndex]}} ⌄</view></picker></view>
      <view class="muted">按实际发生日期排列，可补记历史经历。</view>
      <view wx:if="{{!timeline.length}}" class="empty">{{summary.encounters.length ? '没有符合条件的记录' : '还没有时间线记录'}}</view>
      <template is="healthTimeline" data="{{groups: timeline}}"/>
      <button class="secondary" bindtap="edit" data-kind="encounters">＋ 添加时间线</button>
    </view>
    <view wx:elif="{{archive === 'reports'}}" class="card"><view class="row"><view class="section-title">全部报告</view><view class="small-link" bindtap="compare">报告对比 →</view></view><view wx:if="{{!summary.reports.length}}" class="empty">还没有保存报告</view><view wx:for="{{summary.reports}}" wx:key="id" class="list-row" bindtap="viewReport" data-id="{{item.id}}"><view class="row"><view class="list-title">{{item.title}}</view><view class="tag {{item.status === 'pending' ? 'amber' : ''}}">{{item.status === 'pending' ? '待核对' : '已核对'}}</view></view><view class="muted">{{item.date}} · {{item.kind}} · {{item.files.length}} 份原件</view></view><button class="secondary" bindtap="edit" data-kind="reports">＋ 新增报告</button></view>
    <view wx:else class="card"><picker range="{{metrics}}" range-key="name" value="{{metricIndex}}" bindchange="changeMetric"><view class="picker">{{metrics[metricIndex].name}} ⌄</view></picker><view wx:if="{{trend.reason}}" class="hint">{{trend.reason}}</view><view wx:if="{{trend.comparable}}" class="hint">较上次变化 {{trend.delta}} {{trend.points[0].unit}}。升降本身不代表改善或恶化。</view><view wx:if="{{!trend.points.length}}" class="empty">暂无已核对结果</view><view wx:for="{{trend.points}}" wx:key="reportId" class="list-row" bindtap="viewReport" data-id="{{item.reportId}}"><view class="row"><view>{{item.date}}</view><view>{{item.value}} {{item.unit}}</view></view><view class="muted">参考：{{item.reference || '未填写'}} · {{item.hospital}}</view></view></view>
  </block>
  <block wx:elif="{{page === 'members'}}"><view class="card" wx:for="{{patients}}" wx:key="id"><view class="row"><view class="title">{{item.name}}</view><view class="tag">{{item.relation}}</view></view><view class="muted">出生日期：{{item.birthday || '未填写'}}</view><view class="body-text">过敏史：{{item.allergies || '未填写'}}</view><view class="body-text">既往史：{{item.history || '未填写'}}</view><view class="row"><view class="small-link" bindtap="edit" data-kind="patients" data-id="{{item.id}}">编辑档案</view><view class="small-link" bindtap="removePatient" data-id="{{item.id}}">删除成员</view></view></view><button class="primary" bindtap="edit" data-kind="patients">＋ 添加家庭成员</button><button class="secondary" bindtap="exportHelp">导出资料说明</button></block>
  <view class="page-note">慢慢记录，好好生活。<br/>愈之路 · 本地开发版</view>
</view>
<view class="bottom-nav"><view class="{{page === 'home' ? 'active' : ''}}" bindtap="changePage" data-page="home">⌂<text>首页</text></view><view class="{{page === 'calendar' ? 'active' : ''}}" bindtap="changePage" data-page="calendar">▦<text>日历</text></view><view class="add" bindtap="add">＋</view><view class="{{page === 'archive' ? 'active' : ''}}" bindtap="changePage" data-page="archive">▤<text>档案</text></view><view class="{{page === 'members' ? 'active' : ''}}" bindtap="changePage" data-page="members">♧<text>我的</text></view></view>
