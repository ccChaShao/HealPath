<view class="container"><view class="hint">逐项显示原报告结果。不同单位不自动换算；待核对资料仅供原文对照。趋势与数值变化请到“指标历史”查看。</view><view wx:if="{{reports.length < 2}}" class="card empty">至少需要两份报告才能对比</view><block wx:else><view class="card"><view class="label">第一份报告</view><picker range="{{reports}}" range-key="label" value="{{leftIndex}}" data-side="left" bindchange="change"><view class="picker">{{left.label}} ⌄</view></picker><view class="muted">{{left.status === 'confirmed' ? '已核对' : '待核对'}}</view><view class="label space">第二份报告</view><picker range="{{reports}}" range-key="label" value="{{rightIndex}}" data-side="right" bindchange="change"><view class="picker">{{right.label}} ⌄</view></picker><view class="muted">{{right.status === 'confirmed' ? '已核对' : '待核对'}}</view></view><view wx:if="{{leftIndex === rightIndex}}" class="hint">请选两份不同的报告</view><view wx:else class="card"><view class="row muted"><view>{{left.date}}</view><view>{{right.date}}</view></view><view class="comparison-row" wx:for="{{rows}}" wx:key="id"><view class="list-title">{{item.name}}</view><view class="row"><view class="value">{{item.left ? item.left.value : '未检测 / 未录入'}}<view class="muted">{{item.left.unit}} {{item.left.flag}}<br/>参考：{{item.left.reference || '未填写'}}</view></view><view class="value right">{{item.right ? item.right.value : '未检测 / 未录入'}}<view class="muted">{{item.right.unit}} {{item.right.flag}}<br/>参考：{{item.right.reference || '未填写'}}</view></view></view></view><view wx:if="{{!rows.length}}" class="empty">暂无检验指标，可以查看下面的原件</view></view><view class="card"><view class="section-title">原件对照</view><view class="muted">{{left.label}}</view><view wx:for="{{left.files}}" wx:key="id" class="list-row" data-side="left" data-id="{{item.id}}" bindtap="file">{{item.name}} →</view><view class="divider"/><view class="muted">{{right.label}}</view><view wx:for="{{right.files}}" wx:key="id" class="list-row" data-side="right" data-id="{{item.id}}" bindtap="file">{{item.name}} →</view></view></block></view>
