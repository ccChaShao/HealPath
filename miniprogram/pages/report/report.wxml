<view class="container" wx:if="{{report}}"><view class="card"><view class="title">{{report.title}}</view><view class="muted">{{report.date}} · {{report.hospital || '医院未填写'}}</view><view class="tag {{report.status === 'pending' ? 'amber' : ''}}">{{report.status === 'pending' ? '待核对' : '已核对'}} · 修订 {{report.version}}</view><view class="divider"/><view class="muted">标本：{{report.specimen || '未填写'}}<br/>方法：{{report.method || '未填写'}}</view><view class="body-text">{{report.note}}</view><button class="secondary" bindtap="edit">编辑与核对</button></view><view class="card"><view class="section-title">检验指标</view><view wx:if="{{!report.observations.length}}" class="empty">尚未录入指标</view><view class="metric-row" wx:for="{{report.observations}}" wx:key="metricId"><view>{{item.name}}<view class="muted">参考：{{item.reference || '未填写'}}</view></view><view class="right">{{item.value}} {{item.flag}}<view class="muted">{{item.unit}}</view></view></view><button class="secondary" bindtap="compare">对比历史报告</button></view><view class="card"><view class="section-title">报告原件 · {{report.files.length}} 份</view><view class="list-row" wx:for="{{report.files}}" wx:key="id" data-id="{{item.id}}" bindtap="file"><view class="list-title">{{item.name}}</view><view class="muted">点击查看原件 →</view></view><view wx:if="{{!report.files.length}}" class="empty">还没有上传原件</view><button class="primary" bindtap="photos" disabled="{{busy}}" loading="{{busy}}">拍照 / 从相册添加</button><button class="secondary" bindtap="documents" disabled="{{busy}}">从微信文件添加 PDF / 图片</button><view class="muted">每份不超过 15 MB，最多 30 份。开发者工具的文件选择能力可能与手机不同，也可通过浏览器上传。</view></view></view>
